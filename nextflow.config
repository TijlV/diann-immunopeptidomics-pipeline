docker.enabled = true

params {
    ///////////////////
    /// INPUT FILES ///
    ///////////////////

    // Path to the folder containing the DIA files (absolute path)
    dia_files = "/path/to/data/folder"

    // Choose the file type of the input files (.d, .raw, .mzML)
    file_suffix = ".raw"

    // Path to the FASTA and cRAP file containing the protein sequences (absolute path)
    fasta = "/path/to/fasta"
    crap_fasta = "/path/to/crap.fasta"

    ////////////////////////
    /// OUTPUT DIRECTORY ///
    ////////////////////////

    // Path to the output directory (absolute path)
    outDir = "/path/to/output/folder"

    ///////////////////////////////
    /// GENERAL DIA-NN SETTINGS ///
    ///////////////////////////////

    threads          = 128
    qvalue           = 0.01
    min_corr         = 2.0
    corr_diff        = 1.0
    var_mod          = "UniMod:312,119.004099,C"

    //////////////////////////
    /// LIBRARY GENERATION ///
    //////////////////////////

    // Select true to generate libraries from the FASTA file, false to use existing libraries
    generate_libs = true

    // Only necessary when generate_libs is set to "false"
    // Path to the folder containing the existing .predicted.speclib libraries (absolute path)
    // Make sure the len_libs have the same format as the ones generated by the len_lib_creation module (i.e., lib_len8, lib_len9, etc.)
    empirical_lib = ""
    len_libs = ""

    // General library settings
    min_fr_mz        = 200
    max_fr_mz        = 1800
    min_pr_charge    = 1
    max_pr_charge    = 3
    min_pr_mz_lib    = 350
    max_pr_mz_lib    = 1200

    // Library ranges for the DIA-NN run per length
    lib_ranges_len = [8, 9, 10, 11, 12]

    // Empirical library settings
    min_pep_len      = 8
    max_pep_len      = 12

    // Reference library settings
    mass_acc_ref     = 15.0
    mass_acc_ms1_ref = 15.0
    mass_acc_cal_ref = 25

    /////////////////////////
    /// DIA-NN PARAMETERS ///
    /////////////////////////

    // DIA-NN run 1 settings
    window           = 7
    rt_window_mul    = 1.7
    rt_window_factor = 100
    mass_acc         = 15.0
    mass_acc_ms1     = 15.0
    mass_acc_cal     = 25
    min_cal          = 500
    min_class        = 1000
    var_mods         = 1

    // DIA-NN MBR run settings
    min_pr_mz_2      = 300
    max_pr_mz_2      = 1800
    mass_acc_2       = 15.0
    mass_acc_ms1_2   = 15.0
    min_pep_len_2    = 7
    max_pep_len_2    = 30
    min_pr_charge_2  = 1
    max_pr_charge_2  = 4
}

// Set the process settings for Nextflow
// You can adapt these per process (see Nextflow docs)

process {
    executor = 'local'
    cpus = 128
    memory = 500.GB
}
